<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent" android:gravity="center"
    android:padding="32dp" android:background="?android:attr/colorBackground">
    <TextView android:text="PDF Maker is locked"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="20sp" android:textStyle="bold"
        android:layout_marginBottom="8dp" />
    <TextView android:text="Verify it's you to continue."
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="14sp" android:textColor="@color/text_secondary"
        android:layout_marginBottom="24dp" android:gravity="center" />
    <Button android:id="@+id/btnUnlock" android:text="Unlock"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
</LinearLayout>
